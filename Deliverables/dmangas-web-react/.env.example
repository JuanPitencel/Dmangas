# Core content API
REACT_APP_API_URL_CORE="https://core-api.example.com/api/core"

# Authentication API
REACT_APP_API_URL_AUTH="https://auth-api.example.com/api/users"

# Groups and chapters API
REACT_APP_NODE_API_CORE_URL="https://groups-api.example.com/groups"

# Google OAuth
REACT_APP_GOOGLE_AUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
REACT_APP_GOOGLE_API_RES="https://www.googleapis.com/oauth2/v3/userinfo"

# Set to true to run the app fully offline against the mock data in
# src/mocks/mockApi.js, no backend or Google OAuth client required.
REACT_APP_USE_MOCKS=true
